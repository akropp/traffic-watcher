# Car Counter Configuration
# Copy this file to .env and customize for your deployment

# Headless mode (true = no GUI window, false = show GUI)
HEADLESS=true

# RTSP video source
VIDEO_SOURCE=rtsp://frigate.thekropp.com:8554/driveway

# Video downsampling scale (0.5 = half resolution, 1.0 = original)
# Lower = faster but less accurate. Recommended: 0.5 for CPU, 1.0 for GPU
VIDEO_SCALE=0.5

# Examples:
# VIDEO_SOURCE=rtsp://username:password@camera-ip:port/stream
# VIDEO_SOURCE=/path/to/video/file.mp4
